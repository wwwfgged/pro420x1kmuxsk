// ─── Universal Downloader ─────────────────────────────────────────────────────
class _UniversalDownloader extends StatefulWidget {
  final VoidCallback onSongAdded;
  const _UniversalDownloader({required this.onSongAdded});
  @override
  State<_UniversalDownloader> createState() => _UniversalDownloaderState();
}

class _UniversalDownloaderState extends State<_UniversalDownloader> {
  final _ctrl = TextEditingController();
  final _plCtrl = TextEditingController();
  bool _loading = false;
  String _status = '';
  String? _thumbUrl;
  double _progress = 0;
  String _progressText = '';

  bool get _isYtPlaylist => _ctrl.text.contains('playlist?list=') ||
    (_ctrl.text.contains('youtube') && _ctrl.text.contains('list='));
  bool get _isYt => _ctrl.text.contains('youtube.com') || _ctrl.text.contains('youtu.be');
  bool get _isTt => _ctrl.text.contains('tiktok.com');

  String get _detectedType {
    final url = _ctrl.text.trim();
    if (url.isEmpty) return '';
    if (url.contains('tiktok.com')) return 'TikTok відео';
    if (_isYtPlaylist) return 'YouTube Плейліст';
    if (url.contains('youtube.com') || url.contains('youtu.be')) return 'YouTube Відео';
    return '';
  }

  @override
  Widget build(BuildContext context) {
    final type = _detectedType;
    return SingleChildScrollView(padding: const EdgeInsets.all(20), child: Column(
      crossAxisAlignment: CrossAxisAlignment.start, children: [
        Container(decoration: BoxDecoration(color: const Color(0xFF12121A),
          borderRadius: BorderRadius.circular(16), border: Border.all(color: const Color(0xFF2A2A40))),
          child: TextField(controller: _ctrl, style: const TextStyle(color: Colors.white, fontSize: 14),
            onChanged: (_) => setState(() {}),
            decoration: const InputDecoration(
              hintText: 'Вставте посилання YouTube або TikTok',
              hintStyle: TextStyle(color: Color(0xFF6A6A88), fontSize: 13),
              prefixIcon: Icon(Icons.link_rounded, color: Color(0xFF7C5CFC)),
              border: InputBorder.none, contentPadding: EdgeInsets.all(16)))),
        if (type.isNotEmpty) ...[
          const SizedBox(height: 10),
          Container(padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
            decoration: BoxDecoration(
              color: const Color(0xFF7C5CFC).withOpacity(0.15),
              borderRadius: BorderRadius.circular(8),
              border: Border.all(color: const Color(0xFF7C5CFC).withOpacity(0.3))),
            child: Row(mainAxisSize: MainAxisSize.min, children: [
              const Icon(Icons.auto_awesome_rounded, color: Color(0xFF7C5CFC), size: 14),
              const SizedBox(width: 6),
              Text('Визначено: $type',
                style: const TextStyle(color: Color(0xFF7C5CFC), fontSize: 12, fontWeight: FontWeight.w600)),
            ])),
        ],
        if (_isYtPlaylist) ...[
          const SizedBox(height: 12),
          const Text('Назва папки (плейлісту)', style: TextStyle(color: Color(0xFF6A6A88), fontSize: 13)),
          const SizedBox(height: 8),
          Container(decoration: BoxDecoration(color: const Color(0xFF12121A),
            borderRadius: BorderRadius.circular(16), border: Border.all(color: const Color(0xFF2A2A40))),
            child: TextField(controller: _plCtrl, style: const TextStyle(color: Colors.white, fontSize: 14),
              decoration: const InputDecoration(
                hintText: 'Назва плейлісту...',
                hintStyle: TextStyle(color: Color(0xFF6A6A88), fontSize: 13),
                prefixIcon: Icon(Icons.folder_rounded, color: Color(0xFFFC5C9C)),
                border: InputBorder.none, contentPadding: EdgeInsets.all(16)))),
        ],
        const SizedBox(height: 14),
        GestureDetector(onTap: _loading ? null : _download,
          child: Container(width: double.infinity, padding: const EdgeInsets.symmetric(vertical: 16),
            decoration: BoxDecoration(
              gradient: _loading ? null : const LinearGradient(colors: [Color(0xFF7C5CFC), Color(0xFFFC5C9C)]),
              color: _loading ? const Color(0xFF2A2A40) : null,
              borderRadius: BorderRadius.circular(16)),
            child: Center(child: _loading
              ? Row(mainAxisSize: MainAxisSize.min, children: [
                  const SizedBox(width: 20, height: 20,
                    child: CircularProgressIndicator(strokeWidth: 2, color: Color(0xFF7C5CFC))),
                  const SizedBox(width: 12),
                  Text('Завантаження... $_progressText',
                    style: const TextStyle(color: Colors.white, fontWeight: FontWeight.w600)),
                ])
              : const Row(mainAxisSize: MainAxisSize.min, children: [
                  Icon(Icons.download_rounded, color: Colors.white), SizedBox(width: 8),
                  Text('Завантажити', style: TextStyle(color: Colors.white, fontWeight: FontWeight.w700, fontSize: 16)),
                ])))),
        if (_loading && _progress > 0) ...[
          const SizedBox(height: 12),
          ClipRRect(borderRadius: BorderRadius.circular(8),
            child: LinearProgressIndicator(value: _progress,
              backgroundColor: const Color(0xFF2A2A40),
              valueColor: const AlwaysStoppedAnimation(Color(0xFF7C5CFC)), minHeight: 8)),
          const SizedBox(height: 6),
          Text('${(_progress * 100).toInt()}%  $_progressText',
            style: const TextStyle(color: Color(0xFF6A6A88), fontSize: 12)),
        ],
        if (_thumbUrl != null) ...[
          const SizedBox(height: 16),
          ClipRRect(borderRadius: BorderRadius.circular(16),
            child: Image.network(_thumbUrl!, width: double.infinity, height: 170, fit: BoxFit.cover,
              errorBuilder: (_, __, ___) => const SizedBox.shrink())),
        ],
        if (_status.isNotEmpty) ...[
          const SizedBox(height: 12),
          Container(padding: const EdgeInsets.all(14),
            decoration: BoxDecoration(color: const Color(0xFF12121A),
              borderRadius: BorderRadius.circular(14),
              border: Border.all(color: const Color(0xFF2A2A40))),
            child: Text(_status,
              style: const TextStyle(color: Color(0xFFE8E8F0), fontSize: 13, height: 1.6))),
        ],
      ]));
  }

  Future<void> _download() async {
    final url = _ctrl.text.trim();
    if (url.isEmpty) { setState(() => _status = '⚠️ Вставте посилання'); return; }
    if (_isYtPlaylist) {
      await _downloadYtPlaylist(url);
    } else if (_isYt) {
      await _downloadYtVideo(url);
    } else if (_isTt) {
      await _downloadTikTok(url);
    } else {
      setState(() => _status = '⚠️ Не розпізнано. Підтримується: YouTube, YouTube Playlist, TikTok');
    }
  }

  Future<void> _downloadYtVideo(String url) async {
    setState(() { _loading = true; _status = 'Підключаюсь...'; _progress = 0.05; _thumbUrl = null; });
    final yt = YoutubeExplode();
    try {
      final dir = await _getMusicDir();
      final video = await yt.videos.get(url);
      final safe = video.title.replaceAll(RegExp(r'[<>:"/\\|?*#]'), '').trim();
      setState(() { _thumbUrl = video.thumbnails.highResUrl; _status = 'Знайдено: ${video.title}'; _progress = 0.15; });
      try {
        final t = await http.get(Uri.parse(video.thumbnails.highResUrl)).timeout(const Duration(seconds: 8));
        if (t.statusCode == 200) await File('${dir.path}/$safe.jpg').writeAsBytes(t.bodyBytes);
      } catch (_) {}
      await _downloadYtStream(yt, video.id.value, dir.path, safe);
      widget.onSongAdded();
    } catch (e) {
      setState(() { _status = '❌ Помилка: $e'; _loading = false; _progress = 0; });
    } finally { yt.close(); }
  }

  Future<void> _downloadYtStream(YoutubeExplode yt, String videoId, String savePath, String safe) async {
    setState(() { _status = 'Отримую стріми...'; _progress = 0.25; });
    StreamManifest manifest;
    try {
      manifest = await yt.videos.streams.getManifest(VideoId(videoId),
        ytClients: [YoutubeApiClient.androidVr, YoutubeApiClient.safari, YoutubeApiClient.ios]);
    } catch (_) { manifest = await yt.videos.streams.getManifest(VideoId(videoId)); }
    StreamInfo? info;
    String filePath;
    if (manifest.muxed.isNotEmpty) {
      info = manifest.muxed.sortByVideoQuality().first;
      filePath = '$savePath/$safe.mp4';
      setState(() { _status = 'Завантажую відео 360p...'; _progress = 0.30; });
    } else if (manifest.audioOnly.isNotEmpty) {
      info = manifest.audioOnly.withHighestBitrate();
      filePath = '$savePath/$safe.mp4';
      setState(() { _status = 'Завантажую аудіо...'; _progress = 0.30; });
    } else {
      setState(() { _status = '❌ Немає стрімів'; _loading = false; _progress = 0; }); return;
    }
    final total = info.size.totalBytes;
    var recv = 0;
    final sink = File(filePath).openWrite();
    await for (final chunk in yt.videos.streams.get(info)) {
      sink.add(chunk); recv += chunk.length;
      if (mounted) {
        final p = total > 0 ? 0.30 + (recv / total) * 0.65 : (recv / (30*1024*1024)).clamp(0.30, 0.95);
        setState(() {
          _progress = p;
          _progressText = '${(recv/1024/1024).toStringAsFixed(1)}${total > 0 ? ' / ${(total/1024/1024).toStringAsFixed(1)} MB' : ' MB'}';
        });
      }
    }
    await sink.flush(); await sink.close();
    final size = await File(filePath).length();
    if (size < 10000) {
      try { await File(filePath).delete(); } catch (_) {}
      setState(() { _status = '❌ Порожній файл'; _loading = false; _progress = 0; }); return;
    }
    setState(() {
      _status = '✅ Завантажено!\n$safe\n(${(size/1024/1024).toStringAsFixed(1)} MB)';
      _progress = 1.0; _progressText = ''; _loading = false;
    });
  }

  Future<void> _downloadYtPlaylist(String url) async {
    final plName = _plCtrl.text.trim();
    if (plName.isEmpty) { setState(() => _status = '⚠️ Введіть назву папки плейлісту'); return; }
    setState(() { _loading = true; _status = 'Отримую плейліст...'; _progress = 0.05; _thumbUrl = null; });
    final yt = YoutubeExplode();
    try {
      final base = await _getMusicDir();
      final plDir = Directory('${base.path}/$plName');
      if (!await plDir.exists()) await plDir.create();
      final playlist = await yt.playlists.get(url);
      final videos = await yt.playlists.getVideos(playlist.id).toList();
      final total = videos.length;
      setState(() {
        _status = 'Знайдено: "${playlist.title}"\n$total відео';
        _progress = 0.10;
        _thumbUrl = videos.isNotEmpty ? videos.first.thumbnails.highResUrl : null;
      });
      int done = 0;
      for (final v in videos) {
        if (!mounted) break;
        setState(() {
          _status = '[${done+1}/$total] ${v.title}';
          _progress = 0.10 + (done / total) * 0.88;
          _progressText = '${done+1}/$total';
        });
        try {
          final safe = v.title.replaceAll(RegExp(r'[<>:"/\\|?*#]'), '').trim();
          try {
            final t = await http.get(Uri.parse(v.thumbnails.highResUrl)).timeout(const Duration(seconds: 8));
            if (t.statusCode == 200) await File('${plDir.path}/$safe.jpg').writeAsBytes(t.bodyBytes);
          } catch (_) {}
          StreamManifest manifest;
          try {
            manifest = await yt.videos.streams.getManifest(v.id,
              ytClients: [YoutubeApiClient.androidVr, YoutubeApiClient.safari, YoutubeApiClient.ios]);
          } catch (_) { manifest = await yt.videos.streams.getManifest(v.id); }
          StreamInfo? info;
          String fp;
          if (manifest.muxed.isNotEmpty) {
            info = manifest.muxed.sortByVideoQuality().first; fp = '${plDir.path}/$safe.mp4';
          } else if (manifest.audioOnly.isNotEmpty) {
            info = manifest.audioOnly.withHighestBitrate(); fp = '${plDir.path}/$safe.mp4';
          } else { done++; continue; }
          final sink = File(fp).openWrite();
          await for (final chunk in yt.videos.streams.get(info)) { sink.add(chunk); }
          await sink.flush(); await sink.close();
        } catch (_) {}
        done++;
      }
      setState(() {
        _status = '✅ Плейліст "$plName" завантажено!\n$done/$total відео';
        _progress = 1.0; _progressText = ''; _loading = false;
      });
      widget.onSongAdded();
    } catch (e) {
      setState(() { _status = '❌ Помилка: $e'; _loading = false; _progress = 0; });
    } finally { yt.close(); }
  }

  Future<void> _downloadTikTok(String url) async {
    setState(() { _loading = true; _status = 'Підключаюсь до TikTok...'; _progress = 0.05; _thumbUrl = null; });
    try {
      final dir = await _getMusicDir();
      final r = await http.post(Uri.parse('https://www.tikwm.com/api/'),
        headers: {'Content-Type': 'application/x-www-form-urlencoded', 'User-Agent': 'Mozilla/5.0 (Linux; Android 13)'},
        body: 'url=${Uri.encodeComponent(url)}&count=12&cursor=0&web=1&hd=1',
      ).timeout(const Duration(seconds: 20));
      if (r.statusCode != 200) throw Exception('tikwm статус ${r.statusCode}');
      final d = jsonDecode(r.body);
      if (d['code'] != 0) throw Exception('tikwm: ${d['msg']}');
      final data = d['data'] as Map<String, dynamic>;
      final title = (data['title'] as String? ?? 'TikTok').replaceAll(RegExp(r'[<>:"/\\|?*#]'), '').trim();
      final safe = title.length > 50 ? title.substring(0, 50) : title;
      final dlUrl = data['music_info']?['play'] as String? ?? data['wmplay'] as String? ?? data['play'] as String?;
      final cover = data['cover'] as String?;
      if (cover != null) {
        setState(() => _thumbUrl = cover);
        try {
          final t = await http.get(Uri.parse(cover)).timeout(const Duration(seconds: 8));
          if (t.statusCode == 200) await File('${dir.path}/$safe.jpg').writeAsBytes(t.bodyBytes);
        } catch (_) {}
      }
      if (dlUrl == null) throw Exception('Немає посилання');
      setState(() { _status = 'Знайдено: $title\nЗавантажую...'; _progress = 0.30; });
      final ext = dlUrl.contains('.mp3') ? 'mp3' : 'mp4';
      final req = http.Request('GET', Uri.parse(dlUrl));
      req.headers['User-Agent'] = 'Mozilla/5.0 (Linux; Android 13)';
      req.headers['Referer'] = 'https://www.tiktok.com/';
      final resp = await req.send().timeout(const Duration(minutes: 10));
      final totalB = resp.contentLength ?? 0;
      var recv = 0;
      final sink = File('${dir.path}/$safe.$ext').openWrite();
      await for (final chunk in resp.stream) {
        sink.add(chunk); recv += chunk.length;
        if (mounted) {
          final p = totalB > 0 ? 0.30 + (recv / totalB) * 0.70 : (recv / (20*1024*1024)).clamp(0.30, 0.95);
          setState(() { _progress = p; _progressText = '${(recv/1024/1024).toStringAsFixed(1)} MB'; });
        }
      }
      await sink.flush(); await sink.close();
      final size = await File('${dir.path}/$safe.$ext').length();
      if (size < 5000) throw Exception('Файл порожній');
      setState(() {
        _status = '✅ Завантажено!\n$title\n(${(size/1024/1024).toStringAsFixed(1)} MB)';
        _progress = 1.0; _progressText = ''; _loading = false;
      });
      widget.onSongAdded();
    } catch (e) {
      setState(() { _status = '❌ Помилка: $e'; _loading = false; _progress = 0; });
    }
  }
}

// ─── Mini Player ──────────────────────────────────────────────────────────────
class _MiniPlayer extends StatefulWidget {
  final Song song; final AudioPlayer player;
  final VoidCallback onPrev, onNext, onStop;
  const _MiniPlayer({required this.song, required this.player,
    required this.onPrev, required this.onNext, required this.onStop});
  @override
  State<_MiniPlayer> createState() => _MiniPlayerState();
}

class _MiniPlayerState extends State<_MiniPlayer> {
  bool _p = false; Duration _pos = Duration.zero, _dur = Duration.zero;
  final List<StreamSubscription> _s = [];
  @override
  void initState() {
    super.initState();
    _p = widget.player.playing; _pos = widget.player.position; _dur = widget.player.duration ?? Duration.zero;
    _s.add(widget.player.playingStream.listen((v) { if (mounted) setState(() => _p = v); }));
    _s.add(widget.player.positionStream.listen((v) { if (mounted) setState(() => _pos = v); }));
    _s.add(widget.player.durationStream.listen((v) { if (mounted) setState(() => _dur = v ?? Duration.zero); }));
  }
  @override
  void dispose() { for (final s in _s) s.cancel(); super.dispose(); }
  String _fmt(Duration d) => '${d.inMinutes}:${(d.inSeconds % 60).toString().padLeft(2, '0')}';

  @override
  Widget build(BuildContext context) {
    final progress = _dur.inSeconds > 0 ? (_pos.inSeconds / _dur.inSeconds).clamp(0.0, 1.0) : 0.0;
    return GestureDetector(
      onTap: () => showModalBottomSheet(context: context, isScrollControlled: true,
        backgroundColor: Colors.transparent,
        builder: (_) => _FullPlayer(song: widget.song, player: widget.player,
          onPrev: widget.onPrev, onNext: widget.onNext)),
      child: Container(
        decoration: const BoxDecoration(color: Color(0xFF12121A),
          border: Border(top: BorderSide(color: Color(0xFF2A2A40)))),
        child: Column(mainAxisSize: MainAxisSize.min, children: [
          SliderTheme(data: SliderThemeData(trackHeight: 2,
            thumbShape: const RoundSliderThumbShape(enabledThumbRadius: 5),
            overlayShape: const RoundSliderOverlayShape(overlayRadius: 10),
            activeTrackColor: const Color(0xFF7C5CFC), inactiveTrackColor: const Color(0xFF2A2A40),
            thumbColor: const Color(0xFF7C5CFC), overlayColor: const Color(0xFF7C5CFC).withOpacity(0.2)),
            child: Slider(value: progress,
              onChanged: (v) => widget.player.seek(Duration(seconds: (v * _dur.inSeconds).round())))),
          Padding(padding: const EdgeInsets.fromLTRB(12, 0, 4, 8),
            child: Row(children: [
              _SongCover(coverPath: widget.song.coverPath, active: true, size: 40),
              const SizedBox(width: 10),
              Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                Text(widget.song.title, style: const TextStyle(fontWeight: FontWeight.w600, fontSize: 13),
                  maxLines: 1, overflow: TextOverflow.ellipsis),
                Text('${_fmt(_pos)} / ${_fmt(_dur)}',
                  style: const TextStyle(color: Color(0xFF6A6A88), fontSize: 10)),
              ])),
              IconButton(padding: EdgeInsets.zero, constraints: const BoxConstraints(minWidth: 36, minHeight: 36),
                icon: const Icon(Icons.skip_previous_rounded, color: Color(0xFF6A6A88), size: 26),
                onPressed: widget.onPrev),
              IconButton(padding: EdgeInsets.zero, constraints: const BoxConstraints(minWidth: 36, minHeight: 36),
                icon: Icon(_p ? Icons.pause_circle_filled_rounded : Icons.play_circle_filled_rounded,
                  color: const Color(0xFF7C5CFC), size: 34),
                onPressed: () => _p ? widget.player.pause() : widget.player.play()),
              IconButton(padding: EdgeInsets.zero, constraints: const BoxConstraints(minWidth: 36, minHeight: 36),
                icon: const Icon(Icons.skip_next_rounded, color: Color(0xFF6A6A88), size: 26),
                onPressed: widget.onNext),
              IconButton(padding: EdgeInsets.zero, constraints: const BoxConstraints(minWidth: 32, minHeight: 36),
                icon: const Icon(Icons.close_rounded, color: Color(0xFF6A6A88), size: 22),
                onPressed: widget.onStop),
            ])),
        ])));
  }
}

// ─── Full Player ──────────────────────────────────────────────────────────────
class _FullPlayer extends StatefulWidget {
  final Song song; final AudioPlayer player; final VoidCallback onPrev, onNext;
  const _FullPlayer({required this.song, required this.player, required this.onPrev, required this.onNext});
  @override
  State<_FullPlayer> createState() => _FullPlayerState();
}

class _FullPlayerState extends State<_FullPlayer> {
  bool _p = false; Duration _pos = Duration.zero, _dur = Duration.zero;
  final List<StreamSubscription> _s = [];
  @override
  void initState() {
    super.initState();
    _p = widget.player.playing; _pos = widget.player.position; _dur = widget.player.duration ?? Duration.zero;
    _s.add(widget.player.playingStream.listen((v) { if (mounted) setState(() => _p = v); }));
    _s.add(widget.player.positionStream.listen((v) { if (mounted) setState(() => _pos = v); }));
    _s.add(widget.player.durationStream.listen((v) { if (mounted) setState(() => _dur = v ?? Duration.zero); }));
  }
  @override
  void dispose() { for (final s in _s) s.cancel(); super.dispose(); }
  String _fmt(Duration d) => '${d.inMinutes}:${(d.inSeconds % 60).toString().padLeft(2, '0')}';

  @override
  Widget build(BuildContext context) {
    final progress = _dur.inSeconds > 0 ? (_pos.inSeconds / _dur.inSeconds).clamp(0.0, 1.0) : 0.0;
    return Container(
      height: MediaQuery.of(context).size.height * 0.88,
      decoration: const BoxDecoration(color: Color(0xFF0A0A0F),
        borderRadius: BorderRadius.vertical(top: Radius.circular(28))),
      child: Stack(children: [
        if (widget.song.coverPath != null)
          Positioned.fill(child: ClipRRect(
            borderRadius: const BorderRadius.vertical(top: Radius.circular(28)),
            child: Opacity(opacity: 0.07,
              child: Image.file(File(widget.song.coverPath!), fit: BoxFit.cover)))),
        Column(children: [
          const SizedBox(height: 12),
          Container(width: 40, height: 4, decoration: BoxDecoration(
            color: const Color(0xFF2A2A40), borderRadius: BorderRadius.circular(2))),
          const SizedBox(height: 28),
          Container(
            decoration: BoxDecoration(borderRadius: BorderRadius.circular(24),
              boxShadow: [BoxShadow(color: const Color(0xFF7C5CFC).withOpacity(0.35),
                blurRadius: 40, offset: const Offset(0, 20))]),
            child: ClipRRect(borderRadius: BorderRadius.circular(24),
              child: widget.song.coverPath != null
                ? Image.file(File(widget.song.coverPath!), width: 240, height: 240, fit: BoxFit.cover)
                : Container(width: 240, height: 240,
                    decoration: const BoxDecoration(
                      gradient: LinearGradient(colors: [Color(0xFF7C5CFC), Color(0xFFFC5C9C)])),
                    child: const Icon(Icons.music_note_rounded, size: 90, color: Colors.white)))),
          const SizedBox(height: 28),
          Padding(padding: const EdgeInsets.symmetric(horizontal: 32),
            child: Text(widget.song.title,
              style: const TextStyle(fontSize: 22, fontWeight: FontWeight.w800),
              textAlign: TextAlign.center, maxLines: 2, overflow: TextOverflow.ellipsis)),
          const SizedBox(height: 6),
          Text(widget.song.artist, style: const TextStyle(color: Color(0xFF6A6A88), fontSize: 15)),
          const SizedBox(height: 28),
          Padding(padding: const EdgeInsets.symmetric(horizontal: 28),
            child: Column(children: [
              SliderTheme(data: SliderThemeData(trackHeight: 3,
                thumbShape: const RoundSliderThumbShape(enabledThumbRadius: 7),
                overlayShape: const RoundSliderOverlayShape(overlayRadius: 14),
                activeTrackColor: const Color(0xFF7C5CFC), inactiveTrackColor: const Color(0xFF2A2A40),
                thumbColor: Colors.white, overlayColor: const Color(0xFF7C5CFC).withOpacity(0.2)),
                child: Slider(value: progress,
                  onChanged: (v) => widget.player.seek(Duration(seconds: (v * _dur.inSeconds).round())))),
              Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [
                Text(_fmt(_pos), style: const TextStyle(color: Color(0xFF6A6A88), fontSize: 12)),
                Text(_fmt(_dur), style: const TextStyle(color: Color(0xFF6A6A88), fontSize: 12)),
              ]),
            ])),
          const SizedBox(height: 20),
          Row(mainAxisAlignment: MainAxisAlignment.spaceEvenly, children: [
            IconButton(icon: const Icon(Icons.skip_previous_rounded, size: 38, color: Color(0xFF6A6A88)),
              onPressed: () { Navigator.pop(context); widget.onPrev(); }),
            Container(width: 72, height: 72,
              decoration: BoxDecoration(
                gradient: const LinearGradient(colors: [Color(0xFF7C5CFC), Color(0xFFFC5C9C)]),
                shape: BoxShape.circle,
                boxShadow: [BoxShadow(color: const Color(0xFF7C5CFC).withOpacity(0.4),
                  blurRadius: 24, offset: const Offset(0, 8))]),
              child: IconButton(
                icon: Icon(_p ? Icons.pause_rounded : Icons.play_arrow_rounded, size: 40, color: Colors.white),
                onPressed: () => _p ? widget.player.pause() : widget.player.play())),
            IconButton(icon: const Icon(Icons.skip_next_rounded, size: 38, color: Color(0xFF6A6A88)),
              onPressed: () { Navigator.pop(context); widget.onNext(); }),
          ]),
        ]),
      ]));
  }
}
