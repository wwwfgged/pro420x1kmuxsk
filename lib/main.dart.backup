import 'dart:async';
import 'dart:io';
import 'dart:convert';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:audioplayers/audioplayers.dart';
import 'package:http/http.dart' as http;
import 'package:path_provider/path_provider.dart';
import 'package:youtube_explode_dart/youtube_explode_dart.dart';
import 'package:window_manager/window_manager.dart';

Future<Directory> getMusicDir() async {
  final home = Platform.environment['HOME'] ?? '.';
  final dir = Directory('$home/Music/muzik420');
  if (!await dir.exists()) await dir.create(recursive: true);
  return dir;
}

void main() async {
  WidgetsFlutterBinding.ensureInitialized();
  await windowManager.ensureInitialized();
  await windowManager.setAlwaysOnTop(false);
  await windowManager.setTitleBarStyle(TitleBarStyle.normal);
  await windowManager.setMinimumSize(const Size(400, 300));
  await windowManager.setMaximumSize(const Size(1200, 800));
  await windowManager.setResizable(true);
  await windowManager.setSize(const Size(800, 600));
  await windowManager.center();
  runApp(const Pro420App());
}

class Pro420App extends StatelessWidget {
  const Pro420App({super.key});
  @override
  Widget build(BuildContext context) => MaterialApp(
    title: 'pro420x1kmuxsk',
    debugShowCheckedModeBanner: false,
    theme: ThemeData.dark().copyWith(
      scaffoldBackgroundColor: const Color(0xFF0A0A0F),
      colorScheme: const ColorScheme.dark(primary: Color(0xFF7C5CFC), secondary: Color(0xFFFC5C9C))),
    home: const MainScreen());
}

class Song {
  final String title;
  final String artist;
  final String filePath;
  final String? coverPath;
  Song({required this.title, required this.artist, required this.filePath, this.coverPath});
}

class MusicPlaylist {
  final String name;
  final Directory dir;
  final List<Song> songs;
  MusicPlaylist({required this.name, required this.dir, required this.songs});
}

class MainScreen extends StatefulWidget {
  const MainScreen({super.key});
  @override
  State<MainScreen> createState() => _MainScreenState();
}

class _MainScreenState extends State<MainScreen> with WidgetsBindingObserver, WindowListener {
  int _tab = 0;
  final _player = AudioPlayer();
  List<Song> _songs = [];
  List<MusicPlaylist> _playlists = [];
  Song? _currentSong;
  List<Song> _queue = [];
  int? _currentIndex;
  bool _editMode = false;
  bool _isPlaying = false;
  Duration _position = Duration.zero;
  Duration _duration = Duration.zero;
  bool _isMinimized = false;
  int _versionTapCount = 0;
  Timer? _versionTapTimer;

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addObserver(this);
    windowManager.addListener(this);
    _loadAll();
    _player.onPositionChanged.listen((p) { if (mounted) setState(() => _position = p); });
    _player.onDurationChanged.listen((d) { if (mounted) setState(() => _duration = d); });
    _player.onPlayerStateChanged.listen((s) {
      if (mounted) setState(() => _isPlaying = (s == PlayerState.playing));
      if (s == PlayerState.completed) _playNext();
    });
  }

  @override
  void onWindowMinimize() async {
    if (!_isMinimized) await _setMiniMode(true);
  }

  @override
  void onWindowRestore() async {
    if (_isMinimized) await _setMiniMode(false);
  }

  Future<void> _setMiniMode(bool mini) async {
    if (mini == _isMinimized) return;
    setState(() => _isMinimized = mini);
    if (mini) {
      await windowManager.setAlwaysOnTop(true);
      await windowManager.setTitleBarStyle(TitleBarStyle.hidden);
      await windowManager.setMinimumSize(const Size(320, 120));
      await windowManager.setMaximumSize(const Size(320, 120));
      await windowManager.setResizable(false);
      await windowManager.setSize(const Size(320, 120));
    } else {
      await windowManager.setAlwaysOnTop(false);
      await windowManager.setTitleBarStyle(TitleBarStyle.normal);
      await windowManager.setMinimumSize(const Size(400, 300));
      await windowManager.setMaximumSize(const Size(1200, 800));
      await windowManager.setResizable(true);
      await windowManager.setSize(const Size(800, 600));
      await windowManager.center();
    }
  }

  void _toggleMinimize() => _setMiniMode(!_isMinimized);

  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    if (state == AppLifecycleState.detached) _player.stop();
  }

  bool _isAudio(String p) => RegExp(r'\.(mp3|m4a|aac|mp4|webm|ogg)$').hasMatch(p);

  Future<void> _loadAll() async {
    final base = await getMusicDir();
    final songs = <Song>[];
    final playlists = <MusicPlaylist>[];
    final Set<String> inPlaylist = {};
    try {
      for (final e in base.listSync(recursive: false)) {
        if (e is Directory) {
          final plName = e.path.split('/').last;
          final plSongs = <Song>[];
          for (final f in e.listSync(recursive: false)) {
            if (f is File && _isAudio(f.path)) {
              final name = f.path.split('/').last.replaceAll(RegExp(r'\.(mp3|m4a|aac|mp4|webm|ogg)$'), '');
              final cover = f.path.replaceAll(RegExp(r'\.(mp3|m4a|aac|mp4|webm|ogg)$'), '.jpg');
              final song = Song(title: name, artist: plName,
                filePath: f.path, coverPath: File(cover).existsSync() ? cover : null);
              plSongs.add(song);
              inPlaylist.add(f.path);
            }
          }
          playlists.add(MusicPlaylist(name: plName, dir: e, songs: plSongs));
        }
      }
    } catch (_) {}
    final rootDirs = [base, Directory('/storage/emulated/0/Music'), Directory('/storage/emulated/0/Download')];
    for (final d in rootDirs) {
      if (!await d.exists()) continue;
      try {
        for (final e in d.listSync(recursive: false)) {
          if (e is File && _isAudio(e.path) && !inPlaylist.contains(e.path)) {
            final name = e.path.split('/').last.replaceAll(RegExp(r'\.(mp3|m4a|aac|mp4|webm|ogg)$'), '');
            final cover = e.path.replaceAll(RegExp(r'\.(mp3|m4a|aac|mp4|webm|ogg)$'), '.jpg');
            songs.add(Song(title: name, artist: 'Невідомий виконавець',
              filePath: e.path, coverPath: File(cover).existsSync() ? cover : null));
          }
        }
      } catch (_) {}
    }
    if (mounted) setState(() { _songs = songs; _playlists = playlists; });
  }

  Future<void> _playSong(Song song, {List<Song>? queue}) async {
    final q = queue ?? _songs;
    final idx = q.indexWhere((s) => s.filePath == song.filePath);
    setState(() { _currentSong = song; _queue = List.from(q); _currentIndex = idx < 0 ? 0 : idx; });
    try {
      await _player.setSource(DeviceFileSource(song.filePath));
      await _player.resume();
    } catch (e) {
      if (mounted) ScaffoldMessenger.of(context).showSnackBar(SnackBar(
        content: Text('❌ $e'), backgroundColor: Colors.red, behavior: SnackBarBehavior.floating));
    }
  }

  void _playNext() {
    if (_queue.isEmpty || _currentIndex == null) return;
    _playSong(_queue[(_currentIndex! + 1) % _queue.length], queue: _queue);
  }
  void _playPrev() {
    if (_queue.isEmpty || _currentIndex == null) return;
    _playSong(_queue[(_currentIndex! - 1 + _queue.length) % _queue.length], queue: _queue);
  }
  Future<void> _stopPlayer() async {
    await _player.stop();
    if (mounted) setState(() { _currentSong = null; _queue = []; _currentIndex = null; });
    if (_isMinimized) await _setMiniMode(false);
  }

  Future<void> _deleteSong(Song song) async {
    final ok = await _confirmDialog('Видалити "${song.title}"?');
    if (ok != true) return;
    if (_currentSong?.filePath == song.filePath) await _stopPlayer();
    try { await File(song.filePath).delete(); } catch (_) {}
    if (song.coverPath != null) try { await File(song.coverPath!).delete(); } catch (_) {}
    _loadAll();
  }
  Future<void> _renameSong(Song song) async {
    final ctrl = TextEditingController(text: song.title);
    final name = await _inputDialog('Перейменувати', ctrl);
    if (name == null || name.isEmpty || name == song.title) return;
    final dir = File(song.filePath).parent.path;
    final ext = song.filePath.split('.').last;
    try {
      await File(song.filePath).rename('$dir/$name.$ext');
      if (song.coverPath != null) await File(song.coverPath!).rename('$dir/$name.jpg');
    } catch (_) {}
    if (_currentSong?.filePath == song.filePath) await _stopPlayer();
    _loadAll();
  }
  Future<void> _changeCover(Song song) async { return; }
  void _moveSong(Song song, int dir) {
    final idx = _songs.indexWhere((s) => s.filePath == song.filePath);
    if (idx < 0) return;
    final ni = (idx + dir).clamp(0, _songs.length - 1);
    if (ni == idx) return;
    setState(() {
      _songs.removeAt(idx);
      _songs.insert(ni, song);
      if (_currentIndex == idx) _currentIndex = ni;
      else if (_currentIndex == ni) _currentIndex = idx;
    });
  }
  void _showSongMenu(Song song, {bool inPlaylist = false}) {
    final idx = _songs.indexWhere((s) => s.filePath == song.filePath);
    showModalBottomSheet(context: context, backgroundColor: Colors.transparent,
      builder: (_) => _EditSheet(title: song.title, options: [
        _EditOpt(Icons.delete_outline_rounded, Colors.red, 'Видалити',
          () { Navigator.pop(context); _deleteSong(song); }),
        if (!inPlaylist) _EditOpt(Icons.drive_file_rename_outline_rounded, const Color(0xFF7C5CFC), 'Перейменувати',
          () { Navigator.pop(context); _renameSong(song); }),
        if (!inPlaylist) _EditOpt(Icons.arrow_upward_rounded, const Color(0xFF4CAF50), 'Вгору',
          idx > 0 ? () { Navigator.pop(context); _moveSong(song, -1); } : null),
        if (!inPlaylist) _EditOpt(Icons.arrow_downward_rounded, const Color(0xFF4CAF50), 'Вниз',
          idx < _songs.length - 1 ? () { Navigator.pop(context); _moveSong(song, 1); } : null),
        _EditOpt(Icons.image_rounded, const Color(0xFFFC5C9C), 'Обкладинка',
          () { Navigator.pop(context); _changeCover(song); }),
        if (!inPlaylist) _EditOpt(Icons.playlist_add_rounded, const Color(0xFFFFAA00), 'Додати до плейлісту',
          () { Navigator.pop(context); _addToPlaylistDialog(song); }),
      ]));
  }
  Future<void> _createPlaylist() async {
    final ctrl = TextEditingController();
    final name = await _inputDialog('Новий плейліст', ctrl, hint: 'Назва плейлісту');
    if (name == null || name.isEmpty) return;
    final base = await getMusicDir();
    final plDir = Directory('${base.path}/$name');
    if (!await plDir.exists()) await plDir.create();
    _loadAll();
  }
  Future<void> _deletePlaylist(MusicPlaylist pl) async {
    final ok = await _confirmDialog('Видалити "${pl.name}" з усіма піснями?');
    if (ok != true) return;
    if (_currentSong != null && pl.songs.any((s) => s.filePath == _currentSong!.filePath)) {
      await _stopPlayer();
    }
    try { await pl.dir.delete(recursive: true); } catch (_) {}
    _loadAll();
  }
  Future<void> _addToPlaylistDialog(Song song) async {
    if (_playlists.isEmpty) {
      final ok = await _confirmDialog('Немає плейлістів. Створити новий?');
      if (ok != true) return;
      await _createPlaylist();
      if (_playlists.isEmpty) return;
    }
    final pl = await showDialog<MusicPlaylist>(context: context, builder: (_) => AlertDialog(
      backgroundColor: const Color(0xFF12121A),
      title: const Text('Перемістити до плейлісту', style: TextStyle(color: Colors.white)),
      content: Column(mainAxisSize: MainAxisSize.min,
        children: _playlists.map((p) => ListTile(
          leading: const Icon(Icons.queue_music_rounded, color: Color(0xFF7C5CFC)),
          title: Text(p.name, style: const TextStyle(color: Colors.white)),
          subtitle: Text('${p.songs.length} пісень', style: const TextStyle(color: Color(0xFF6A6A88))),
          onTap: () => Navigator.pop(context, p))).toList())));
    if (pl == null) return;
    try {
      final dest = '${pl.dir.path}/${song.filePath.split('/').last}';
      await File(song.filePath).copy(dest);
      if (song.coverPath != null) {
        await File(song.coverPath!).copy('${pl.dir.path}/${song.coverPath!.split('/').last}');
        await File(song.coverPath!).delete();
      }
      await File(song.filePath).delete();
      if (_currentSong?.filePath == song.filePath) await _stopPlayer();
      if (mounted) ScaffoldMessenger.of(context).showSnackBar(SnackBar(
        content: Text('✅ Переміщено до "${pl.name}"'), backgroundColor: const Color(0xFF4CAF50),
        behavior: SnackBarBehavior.floating));
    } catch (e) {
      if (mounted) ScaffoldMessenger.of(context).showSnackBar(SnackBar(
        content: Text('❌ $e'), backgroundColor: Colors.red, behavior: SnackBarBehavior.floating));
    }
    _loadAll();
  }
  Future<bool?> _confirmDialog(String msg) => showDialog<bool>(context: context,
    builder: (_) => AlertDialog(
      backgroundColor: const Color(0xFF12121A),
      content: Text(msg, style: const TextStyle(color: Colors.white)),
      actions: [
        TextButton(onPressed: () => Navigator.pop(context, false),
          child: const Text('Скасувати', style: TextStyle(color: Color(0xFF6A6A88)))),
        TextButton(onPressed: () => Navigator.pop(context, true),
          child: const Text('Так', style: TextStyle(color: Colors.red))),
      ]));
  Future<String?> _inputDialog(String title, TextEditingController ctrl, {String hint = ''}) =>
    showDialog<String>(context: context, builder: (_) => AlertDialog(
      backgroundColor: const Color(0xFF12121A),
      title: Text(title, style: const TextStyle(color: Colors.white)),
      content: TextField(controller: ctrl, autofocus: true,
        style: const TextStyle(color: Colors.white),
        decoration: InputDecoration(hintText: hint,
          hintStyle: const TextStyle(color: Color(0xFF6A6A88)),
          filled: true, fillColor: const Color(0xFF1A1A28),
          border: OutlineInputBorder(borderRadius: BorderRadius.circular(10),
            borderSide: const BorderSide(color: Color(0xFF2A2A40))),
          focusedBorder: OutlineInputBorder(borderRadius: BorderRadius.circular(10),
            borderSide: const BorderSide(color: Color(0xFF7C5CFC))))),
      actions: [
        TextButton(onPressed: () => Navigator.pop(context),
          child: const Text('Скасувати', style: TextStyle(color: Color(0xFF6A6A88)))),
        TextButton(onPressed: () => Navigator.pop(context, ctrl.text.trim()),
          child: const Text('OK', style: TextStyle(color: Color(0xFF7C5CFC)))),
      ]));

  void _onVersionTap() {
    _versionTapCount++;
    if (_versionTapTimer != null) {
      _versionTapTimer!.cancel();
      _versionTapTimer = null;
    }
    _versionTapTimer = Timer(const Duration(milliseconds: 500), () {
      _versionTapCount = 0;
      _versionTapTimer = null;
    });
    if (_versionTapCount >= 3) {
      _versionTapCount = 0;
      _versionTapTimer?.cancel();
      _versionTapTimer = null;
      _launchDoom();
    }
  }

  void _launchDoom() async {
    final doomCmds = ['chocolate-doom', 'gzdoom', 'doom'];
    String? found;
    for (final cmd in doomCmds) {
      final result = await Process.run('which', [cmd]).catchError((_) => null);
      if (result != null && result.exitCode == 0) {
        found = cmd;
        break;
      }
    }
    if (found != null) {
      try {
        await Process.start(found, []);
        if (mounted) {
          ScaffoldMessenger.of(context).showSnackBar(const SnackBar(
            content: Text('🔥 DOOM запущено!', style: TextStyle(fontWeight: FontWeight.bold)),
            backgroundColor: Color(0xFF7C5CFC),
            behavior: SnackBarBehavior.floating,
          ));
        }
      } catch (e) {
        _showDoomInstallDialog();
      }
    } else {
      _showDoomInstallDialog();
    }
  }

  void _showDoomInstallDialog() {
    showDialog(
      context: context,
      builder: (_) => AlertDialog(
        backgroundColor: const Color(0xFF12121A),
        title: const Text('🔥 DOOM не знайдено!', style: TextStyle(color: Colors.white)),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: const [
            Text('Щоб запустити DOOM, встановіть один із портів:', style: TextStyle(color: Colors.white70)),
            SizedBox(height: 8),
            Text('• chocolate-doom', style: TextStyle(color: Color(0xFF7C5CFC))),
            Text('• gzdoom', style: TextStyle(color: Color(0xFFFC5C9C))),
            SizedBox(height: 8),
            Text('Команда для Fedora:', style: TextStyle(color: Colors.white70)),
            Text('sudo dnf install chocolate-doom', style: TextStyle(color: Color(0xFF4CAF50), fontFamily: 'monospace')),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('Закрити', style: TextStyle(color: Color(0xFF6A6A88))),
          ),
        ],
      ),
    );
  }

  @override
  void dispose() {
    WidgetsBinding.instance.removeObserver(this);
    windowManager.removeListener(this);
    _player.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return _isMinimized
        ? _MiniPlayerWidget(
            song: _currentSong,
            isPlaying: _isPlaying,
            position: _position,
            duration: _duration,
            onPlayPause: () => _isPlaying ? _player.pause() : _player.resume(),
            onNext: _playNext,
            onPrev: _playPrev,
            onStop: _stopPlayer,
            onExpand: () => _setMiniMode(false),
          )
        : Scaffold(
            backgroundColor: const Color(0xFF0A0A0F),
            body: Column(children: [
              Expanded(child: IndexedStack(index: _tab, children: [
                _SongsTab(
                  songs: _songs,
                  playlists: _playlists,
                  currentSong: _currentSong,
                  onPlay: (s) => _playSong(s, queue: _songs),
                  onPlayPlaylist: (s, pl) => _playSong(s, queue: pl.songs),
                  onRefresh: _loadAll,
                  editMode: _editMode,
                  onToggleEdit: () => setState(() => _editMode = !_editMode),
                  onSongMenu: _showSongMenu,
                  onCreatePlaylist: _createPlaylist,
                  onDeletePlaylist: _deletePlaylist,
                  onVersionTap: _onVersionTap,
                ),
                _DownloadTab(onSongAdded: _loadAll),
              ])),
              if (_currentSong != null) _MiniPlayerBar(
                song: _currentSong!,
                isPlaying: _isPlaying,
                position: _position,
                duration: _duration,
                onPlayPause: () => _isPlaying ? _player.pause() : _player.resume(),
                onNext: _playNext,
                onPrev: _playPrev,
                onStop: _stopPlayer,
                onMinimize: _toggleMinimize,
              ),
              _BottomNav(current: _tab, onChange: (i) => setState(() => _tab = i)),
            ]),
          );
  }
}

class _MiniPlayerWidget extends StatelessWidget {
  final Song? song;
  final bool isPlaying;
  final Duration position, duration;
  final VoidCallback onPlayPause, onNext, onPrev, onStop, onExpand;
  const _MiniPlayerWidget({this.song, required this.isPlaying, required this.position,
    required this.duration, required this.onPlayPause, required this.onNext,
    required this.onPrev, required this.onStop, required this.onExpand});

  String _fmt(Duration d) => '${d.inMinutes}:${(d.inSeconds % 60).toString().padLeft(2, '0')}';

  @override
  Widget build(BuildContext context) {
    return Container(
      width: 320,
      height: 120,
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: const Color(0xFF12121A),
        borderRadius: BorderRadius.circular(16),
        border: Border.all(color: const Color(0xFF2A2A40)),
      ),
      child: Column(children: [
        Row(children: [
          if (song?.coverPath != null)
            ClipRRect(
              borderRadius: BorderRadius.circular(8),
              child: Image.file(File(song!.coverPath!), width: 48, height: 48, fit: BoxFit.cover))
          else
            Container(
              width: 48,
              height: 48,
              decoration: const BoxDecoration(
                gradient: LinearGradient(colors: [Color(0xFF7C5CFC), Color(0xFFFC5C9C)]),
                borderRadius: BorderRadius.all(Radius.circular(8)),
              ),
              child: const Icon(Icons.music_note, color: Colors.white)),
          const SizedBox(width: 10),
          Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
            Text(song?.title ?? 'Немає пісні',
              style: const TextStyle(fontWeight: FontWeight.w600, fontSize: 13), maxLines: 1, overflow: TextOverflow.ellipsis),
            Text('${_fmt(position)} / ${_fmt(duration)}',
              style: const TextStyle(color: Color(0xFF6A6A88), fontSize: 10)),
          ])),
          IconButton(icon: const Icon(Icons.close_rounded, size: 18, color: Color(0xFF6A6A88)),
            onPressed: onStop, padding: EdgeInsets.zero, constraints: const BoxConstraints()),
          IconButton(icon: const Icon(Icons.open_in_full_rounded, size: 18, color: Color(0xFF6A6A88)),
            onPressed: onExpand, padding: EdgeInsets.zero, constraints: const BoxConstraints()),
        ]),
        const SizedBox(height: 4),
        Row(mainAxisAlignment: MainAxisAlignment.center, children: [
          IconButton(icon: const Icon(Icons.skip_previous_rounded, color: Color(0xFF6A6A88), size: 22),
            onPressed: onPrev, padding: EdgeInsets.zero, constraints: const BoxConstraints()),
          IconButton(icon: Icon(isPlaying ? Icons.pause_circle_filled : Icons.play_circle_filled,
            color: const Color(0xFF7C5CFC), size: 32),
            onPressed: onPlayPause, padding: EdgeInsets.zero, constraints: const BoxConstraints()),
          IconButton(icon: const Icon(Icons.skip_next_rounded, color: Color(0xFF6A6A88), size: 22),
            onPressed: onNext, padding: EdgeInsets.zero, constraints: const BoxConstraints()),
        ]),
      ]),
    );
  }
}

class _MiniPlayerBar extends StatelessWidget {
  final Song song;
  final bool isPlaying;
  final Duration position, duration;
  final VoidCallback onPlayPause, onNext, onPrev, onStop, onMinimize;
  const _MiniPlayerBar({required this.song, required this.isPlaying, required this.position,
    required this.duration, required this.onPlayPause, required this.onNext,
    required this.onPrev, required this.onStop, required this.onMinimize});

  String _fmt(Duration d) => '${d.inMinutes}:${(d.inSeconds % 60).toString().padLeft(2, '0')}';

  @override
  Widget build(BuildContext context) {
    return Container(
      decoration: BoxDecoration(
        color: const Color(0xFF12121A),
        borderRadius: BorderRadius.circular(12),
        border: Border.all(color: const Color(0xFF2A2A40)),
      ),
      margin: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
      child: Row(children: [
        ClipRRect(
          borderRadius: BorderRadius.circular(8),
          child: song.coverPath != null
              ? Image.file(File(song.coverPath!), width: 40, height: 40, fit: BoxFit.cover)
              : Container(
                  width: 40,
                  height: 40,
                  decoration: const BoxDecoration(
                    gradient: LinearGradient(colors: [Color(0xFF7C5CFC), Color(0xFFFC5C9C)]),
                    borderRadius: BorderRadius.all(Radius.circular(8)),
                  ),
                  child: const Icon(Icons.music_note, color: Colors.white))),
        const SizedBox(width: 10),
        Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          Text(song.title, style: const TextStyle(fontWeight: FontWeight.w600, fontSize: 13),
            maxLines: 1, overflow: TextOverflow.ellipsis),
          Text('${_fmt(position)} / ${_fmt(duration)}',
            style: const TextStyle(color: Color(0xFF6A6A88), fontSize: 10)),
        ])),
        IconButton(icon: const Icon(Icons.skip_previous_rounded, color: Color(0xFF6A6A88), size: 22),
          onPressed: onPrev, padding: EdgeInsets.zero, constraints: const BoxConstraints()),
        IconButton(icon: Icon(isPlaying ? Icons.pause_circle_filled : Icons.play_circle_filled,
          color: const Color(0xFF7C5CFC), size: 30),
          onPressed: onPlayPause, padding: EdgeInsets.zero, constraints: const BoxConstraints()),
        IconButton(icon: const Icon(Icons.skip_next_rounded, color: Color(0xFF6A6A88), size: 22),
          onPressed: onNext, padding: EdgeInsets.zero, constraints: const BoxConstraints()),
        IconButton(icon: const Icon(Icons.close_rounded, color: Color(0xFF6A6A88), size: 20),
          onPressed: onStop, padding: EdgeInsets.zero, constraints: const BoxConstraints()),
        IconButton(icon: const Icon(Icons.remove_rounded, color: Color(0xFF6A6A88), size: 20),
          onPressed: onMinimize, padding: EdgeInsets.zero, constraints: const BoxConstraints()),
      ]),
    );
  }
}

class _SongsTab extends StatelessWidget {
  final List<Song> songs;
  final List<MusicPlaylist> playlists;
  final Song? currentSong;
  final Function(Song) onPlay;
  final Function(Song, MusicPlaylist) onPlayPlaylist;
  final VoidCallback onRefresh;
  final bool editMode;
  final VoidCallback onToggleEdit;
  final Function(Song, {bool inPlaylist}) onSongMenu;
  final VoidCallback onCreatePlaylist;
  final Function(MusicPlaylist) onDeletePlaylist;
  final VoidCallback onVersionTap;

  const _SongsTab({
    required this.songs, required this.playlists, this.currentSong,
    required this.onPlay, required this.onPlayPlaylist, required this.onRefresh,
    required this.editMode, required this.onToggleEdit, required this.onSongMenu,
    required this.onCreatePlaylist, required this.onDeletePlaylist,
    required this.onVersionTap,
  });

  Future<void> _importFiles(BuildContext context) async { return; }
  void _showHeaderMenu(BuildContext context) {
    showModalBottomSheet(context: context, backgroundColor: Colors.transparent,
      builder: (_) => Container(
        decoration: const BoxDecoration(color: Color(0xFF12121A),
          borderRadius: BorderRadius.vertical(top: Radius.circular(20))),
        padding: const EdgeInsets.fromLTRB(16, 8, 16, 32),
        child: Column(mainAxisSize: MainAxisSize.min, children: [
          Container(width: 36, height: 4, margin: const EdgeInsets.only(bottom: 16),
            decoration: BoxDecoration(color: const Color(0xFF2A2A40), borderRadius: BorderRadius.circular(2))),
          _MenuTile(icon: Icons.create_new_folder_rounded, color: const Color(0xFFFC5C9C),
            label: 'Новий плейліст',
            onTap: () { Navigator.pop(context); onCreatePlaylist(); }),
          _MenuTile(icon: Icons.refresh_rounded, color: const Color(0xFF4CAF50),
            label: 'Оновити список',
            onTap: () { Navigator.pop(context); onRefresh(); }),
        ])));
  }

  @override
  Widget build(BuildContext context) {
    return SafeArea(child: Column(children: [
      Padding(padding: const EdgeInsets.fromLTRB(16, 16, 16, 0),
        child: Row(children: [
          ShaderMask(
            shaderCallback: (b) => const LinearGradient(
              colors: [Color(0xFF7C5CFC), Color(0xFFFC5C9C)]).createShader(b),
            child: const Text('pro420x1kmuxsk',
              style: TextStyle(fontSize: 20, fontWeight: FontWeight.w800, color: Colors.white))),
          const SizedBox(width: 6),
          GestureDetector(
            onTap: onVersionTap,
            child: Container(
              padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 2),
              decoration: BoxDecoration(
                color: Colors.white.withOpacity(0.05),
                borderRadius: BorderRadius.circular(6),
                border: Border.all(color: Colors.white.withOpacity(0.1)),
              ),
              child: Text(
                'v3.0',
                style: TextStyle(
                  color: Colors.white.withOpacity(0.7),
                  fontSize: 11,
                  fontFamily: 'monospace',
                ),
              ),
            ),
          ),
          const Spacer(),
          GestureDetector(onTap: onToggleEdit, child: AnimatedContainer(
            duration: const Duration(milliseconds: 200),
            padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 5),
            decoration: BoxDecoration(
              color: editMode ? const Color(0xFF7C5CFC).withOpacity(0.2) : Colors.transparent,
              border: Border.all(color: editMode ? const Color(0xFF7C5CFC) : const Color(0xFF2A2A40)),
              borderRadius: BorderRadius.circular(8)),
            child: Row(mainAxisSize: MainAxisSize.min, children: [
              Icon(editMode ? Icons.check_rounded : Icons.edit_rounded,
                color: editMode ? const Color(0xFF7C5CFC) : const Color(0xFF6A6A88), size: 15),
              const SizedBox(width: 4),
              Text(editMode ? 'Готово' : 'Ред.', style: TextStyle(
                color: editMode ? const Color(0xFF7C5CFC) : const Color(0xFF6A6A88),
                fontSize: 12, fontWeight: FontWeight.w600)),
            ]))),
          const SizedBox(width: 6),
          IconButton(
            icon: const Icon(Icons.more_vert_rounded, color: Color(0xFF6A6A88), size: 24),
            padding: EdgeInsets.zero, constraints: const BoxConstraints(),
            onPressed: () => _showHeaderMenu(context)),
        ])),
      const SizedBox(height: 8),
      Expanded(child: (songs.isEmpty && playlists.isEmpty)
        ? Center(child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [
            Container(padding: const EdgeInsets.all(28),
              decoration: BoxDecoration(color: const Color(0xFF12121A), borderRadius: BorderRadius.circular(28)),
              child: const Icon(Icons.music_off_rounded, size: 60, color: Color(0xFF6A6A88))),
            const SizedBox(height: 20),
            const Text('Немає пісень', style: TextStyle(fontSize: 20, fontWeight: FontWeight.w700)),
            const SizedBox(height: 8),
            const Text('Завантаж або імпортуй музику',
              style: TextStyle(color: Color(0xFF6A6A88), fontSize: 14)),
          ]))
        : ListView(padding: const EdgeInsets.fromLTRB(16, 0, 16, 16), children: [
            if (songs.isNotEmpty) ...[
              _SectionHeader(icon: Icons.music_note_rounded, title: 'Пісні', count: songs.length),
              ...songs.map((s) => _SongTile(
                song: s,
                active: currentSong?.filePath == s.filePath,
                editMode: editMode,
                onTap: () => onPlay(s),
                onMenu: () => onSongMenu(s))),
            ],
            if (playlists.isNotEmpty) ...[
              const SizedBox(height: 8),
              _SectionHeader(icon: Icons.queue_music_rounded, title: 'Плейлісти', count: playlists.length),
              ...playlists.map((pl) => _PlaylistTile(
                playlist: pl,
                currentSong: currentSong,
                editMode: editMode,
                onDelete: () => onDeletePlaylist(pl),
                onPlaySong: (s) => onPlayPlaylist(s, pl),
                onSongMenu: (s) => onSongMenu(s, inPlaylist: true),
              )),
            ],
          ])),
    ]));
  }
}

